# WhatsApp Gateway Service Configuration

# HTTP Port
PORT=3000

# Security API Key for REST endpoints (X-API-KEY header)
API_KEY=change-this-to-a-secure-random-key

# Webhook Endpoint & Secret (Gateway -> Panel)
WEBHOOK_URL=https://panel.example.com/webhook/gateway
WEBHOOK_SECRET=change-this-to-a-secure-webhook-secret

# MySQL Database Configuration (Hostinger Remote MySQL or local MySQL)
DB_HOST=srv1234.hstgr.io
DB_PORT=3306
DB_USER=u123456789_wagateway
DB_PASS=YourStrongHostingerPassword123
DB_NAME=u123456789_wagateway

# Limits & Operational Settings (Set MAX_SESSIONS=0 for UNLIMITED sessions)
MAX_SESSIONS=0
LOG_LEVEL=info
